<ui:FluentWindow
    x:Class="DocMind.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:DocMind"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:DocMind"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="1920"
    Height="1080"
    AllowsTransparency="False"
    Background="#E1E8F0"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <local:StringIsNotNullOrEmptyConverter x:Key="StringIsNotNullOrEmptyConverter" />
        <local:BooleanToHorizontalAlignmentConverter x:Key="BooleanToHorizontalAlignmentConverter" />
        <local:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
        <local:EqualsConverter x:Key="EqualsConverter" />

        <local:FilePreviewTemplateSelector x:Key="FilePreviewTemplateSelector">
            <local:FilePreviewTemplateSelector.TxtTemplate>
                <DataTemplate>
                    <RichTextBox
                        x:Name="OriginalTextBox"
                        Padding="32,25"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="16"
                        IsReadOnly="True"
                        VerticalScrollBarVisibility="Auto">
                        <i:Interaction.Behaviors>
                            <behaviors:FlowDocumentBehavior BoundDocument="{Binding Display}" />
                        </i:Interaction.Behaviors>

                    </RichTextBox>
                </DataTemplate>
            </local:FilePreviewTemplateSelector.TxtTemplate>

            <local:FilePreviewTemplateSelector.WordTemplate>
                <DataTemplate>
                    <DocumentViewer Margin="10" Document="{Binding Display}" />
                </DataTemplate>
            </local:FilePreviewTemplateSelector.WordTemplate>

            <local:FilePreviewTemplateSelector.ExcelTemplate>
                <DataTemplate>
                    <DataGrid
                        Width="auto"
                        Margin="10"
                        HorizontalAlignment="Stretch"
                        AutoGenerateColumns="True"
                        CanUserAddRows="False"
                        ColumnWidth="*"
                        ItemsSource="{Binding Display.DefaultView}" />

                </DataTemplate>
            </local:FilePreviewTemplateSelector.ExcelTemplate>

            <local:FilePreviewTemplateSelector.DefaultTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Margin="0,0,0,12"
                            FontSize="48"
                            Foreground="#CCCCCC"
                            Symbol="DocumentSearch24" />

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Foreground="#999999"
                            Text="请先选择要预览的文档" />

                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="#BBBBBB"
                            Text="点击左侧按钮进行上传" />
                    </StackPanel>
                </DataTemplate>
            </local:FilePreviewTemplateSelector.DefaultTemplate>
        </local:FilePreviewTemplateSelector>

    </ui:FluentWindow.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#F3F3F3"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnDragWindow">

            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="8,0,0,0"
                        FontSize="20"
                        Foreground="#444444"
                        Symbol="BrainCircuit24" />

                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#444444"
                        Text="DocMind" />
                </StackPanel>

                <ui:Button
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="DarkGray"
                    BorderThickness="1"
                    Click="OnCloseApp"
                    Foreground="#CC3333"
                    Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                    ToolTip="关闭" />
            </Grid>
        </Border>

        <!--  左侧聊天区  -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  上传文件  -->
            <ui:Card
                Grid.Row="0"
                Padding="0"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#F5F5F5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:Button
                            Grid.Column="0"
                            Height="30"
                            Margin="10,0"
                            Appearance="Dark"
                            Background="#6FCF97"
                            Command="{Binding UploadFileCommand}"
                            Content="上传文档"
                            FontSize="14"
                            FontWeight="Normal"
                            Foreground="White"
                            Icon="{ui:SymbolIcon Symbol=ArrowUpload24}" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="#666666"
                            Text="{Binding UploadedFiles.Count, StringFormat='已上传 ({0})'}" />
                    </Grid>

                    <Border
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <ScrollViewer
                        Grid.Row="1"
                        Height="Auto"
                        MaxHeight="120"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding UploadedFiles}">
                            <!--  ItemTemplate保持不变  -->

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DocumentFile}">
                                    <Grid Height="36" Margin="0,2">

                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <!--  用DataTrigger + 多值绑定 + 转换器，判断当前项是否等于SelectedFile  -->
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualsConverter}">
                                                                <!--  绑定1：当前DocumentFile项  -->
                                                                <Binding />
                                                                <!--  绑定2：ViewModel中的SelectedFile  -->
                                                                <Binding Path="DataContext.SelectedFile" RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <!--  选中时的样式：淡蓝色背景  -->

                                                        <Setter Property="Background" Value="#E8F1FC" />
                                                        <!--  文件名选中样式  -->

                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            Orientation="Horizontal">
                                            <!--  通过 InputBinding 绑定鼠标事件与命令  -->
                                            <StackPanel.InputBindings>
                                                <!--  鼠标按下事件绑定  -->
                                                <MouseBinding
                                                    Command="{Binding Path=DataContext.SelectFileCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}"
                                                    MouseAction="LeftClick" />

                                            </StackPanel.InputBindings>

                                            <ui:SymbolIcon
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Symbol="Document20" />


                                            <TextBlock
                                                Margin="2,0,5,0"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding FileName}"
                                                ToolTip="{Binding FilePath}">

                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <!--  默认文字样式  -->
                                                        <Setter Property="Foreground" Value="#333333" />
                                                        <Setter Property="FontWeight" Value="Normal" />

                                                        <!--  选中时的文字样式  -->
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource EqualsConverter}">
                                                                        <!--  绑定1：当前DocumentFile项  -->
                                                                        <Binding />
                                                                        <!--  绑定2：ViewModel中的SelectedFile  -->
                                                                        <Binding Path="DataContext.SelectedFile" RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <!--  选中时的文字颜色+加粗  -->
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />

                                                                <Setter Property="Background" Value="{DynamicResource AccentColorSecondaryBrush}" />


                                                                <!--<Setter Property="FontWeight" Value="Medium"/>-->
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>

                                            </TextBlock>

                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding FileSizeKB, StringFormat='({0}KB)'}" />
                                        </StackPanel>

                                        <ui:Button
                                            Grid.Column="1"
                                            Width="36"
                                            Height="32"
                                            Margin="0,0,6,0"
                                            Appearance="Transparent"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                            Icon="{ui:SymbolIcon Symbol=Delete12}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </ui:Card>

            <!--  信息内容  -->
            <ui:Card
                Grid.Row="1"
                Margin="0,10,0,0"
                Padding="5"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:Message}">
                                <Grid Margin="5,3">
                                    <Grid HorizontalAlignment="{Binding IsSentByUser, Converter={StaticResource BooleanToHorizontalAlignmentConverter}}">
                                        <Border BorderThickness="1" CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F0F0F0" />
                                                    <Setter Property="BorderBrush" Value="#DDDDDD" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSentByUser}" Value="True">
                                                            <Setter Property="Background" Value="#5dade2" />
                                                            <Setter Property="BorderBrush" Value="#5dade2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <!--  消息内容  -->
                                                <TextBlock
                                                    MinHeight="20"
                                                    Margin="4"
                                                    Padding="5"
                                                    FontSize="16"
                                                    Text="{Binding Text}"
                                                    TextWrapping="Wrap">

                                                    <b:Interaction.Behaviors>
                                                        <local:RichTextHyperlinkBehavior JumpToPageCommand="{Binding DataContext.JumpToPageCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
                                                        <local:RichTextHyperlinkBehavior JumpToParagraphCommand="{Binding DataContext.JumpToParagraphCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
                                                    </b:Interaction.Behaviors>

                                                </TextBlock>

                                                <!--  时间戳  -->
                                                <TextBlock
                                                    Margin="0,4,6,6"
                                                    HorizontalAlignment="Right"
                                                    FontSize="10"
                                                    Text="{Binding Timestamp, StringFormat='HH:mm'}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#666666" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSentByUser}" Value="True">
                                                                    <Setter Property="Foreground" Value="#EEEEEE" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </ui:Card>

            <!--  聊天操作  -->
            <ui:Card
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,8"
                Background="#F5F5FF"
                BorderBrush="#D6E4FF"
                BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  当前提示  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:ProgressRing
                            Width="14"
                            Height="14"
                            Margin="10,0,0,0"
                            IsIndeterminate="True"
                            Visibility="{Binding IsRingVisible, Converter={StaticResource BoolToVis}}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Hint}" />
                    </StackPanel>

                    <!--  溯源  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="溯源" />

                        <ui:ToggleSwitch
                            Margin="10,0,5,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsSourcingEnabled}"
                            ToolTip="开启后将验证答案来源，耗时稍长" />
                    </StackPanel>

                    <!--  聊天框 + 按钮  -->
                    <ui:TextBox
                        x:Name="message"
                        Grid.Row="1"
                        Grid.Column="0"
                        Height="40"
                        Margin="0,10,0,0"
                        Padding="10"
                        VerticalContentAlignment="Center"
                        BorderBrush="DarkGray"
                        BorderThickness="1"
                        Cursor="IBeam"
                        KeyDown="TextBox_KeyDown"
                        PlaceholderText="请输入消息..."
                        Text="{Binding UserQuestion, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="80"
                        Height="40"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        Appearance="Transparent"
                        Command="{Binding SendMessageCommand}"
                        Content="发送"
                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Icon="{ui:SymbolIcon Symbol=Send24}" />
                </Grid>
            </ui:Card>
        </Grid>

        <!--  右侧文件区  -->
        <ui:Card
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,10,10,10"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            BorderBrush="#E0E0E0"
            BorderThickness="1">

            <Grid VerticalAlignment="Stretch" Background="#FAFAFA">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  文件预览标题  -->
                <Grid Grid.Row="0" Background="#F5F5F5">

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="10,0,0,0"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Symbol="Document24" />

                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Text="{Binding SelectedFile.FileName, FallbackValue='文档预览'}" />
                    </StackPanel>
                </Grid>

                <!--  文件内容  -->
                <ContentControl
                    x:Name="previewContentControl"
                    Grid.Row="1"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{Binding SelectedFile}"
                    ContentTemplateSelector="{StaticResource FilePreviewTemplateSelector}" />
            </Grid>
        </ui:Card>

        <!--  loading层  -->
        <Grid
            x:Name="GlobalLoadingOverlay"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Panel.ZIndex="999"
            Background="#40000000"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing
                    Width="60"
                    Height="60"
                    Foreground="DarkGray"
                    IsIndeterminate="True" />

                <ui:TextBlock
                    Margin="0,10,0,0"
                    FontWeight="Medium"
                    Foreground="White"
                    Text="{Binding LoadMessage, FallbackValue='Loading...'}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
